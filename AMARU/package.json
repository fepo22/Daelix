{
  "name": "amaru-vgv",
  "private": true,
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=22.12.0",
    "pnpm": ">=12.18.0"
  },
  "scripts": {
    "dev": "corepack pnpm --parallel --filter @amaru/api --filter @amaru/web dev",
    "build": "corepack pnpm -r --if-present build",
    "typecheck": "corepack pnpm -r --if-present typecheck",
    "db:generate": "corepack pnpm --filter @amaru/api db:generate",
    "db:migrate:dev": "corepack pnpm --filter @amaru/api db:migrate:dev",
    "db:migrate:deploy": "corepack pnpm --filter @amaru/api db:migrate:deploy",
    "db:migrate:status": "corepack pnpm --filter @amaru/api db:migrate:status",
    "db:studio": "corepack pnpm --filter @amaru/api db:studio",
    "docker:up": "docker compose up --build",
    "docker:down": "docker compose down"
  },
  "devDependencies": {
    "typescript": "6.0.3"
  }
}
