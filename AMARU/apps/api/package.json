{
  "name": "@amaru/api",
  "version": "0.0.0",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "dev": "corepack pnpm exec prisma generate && nest start --watch",
    "build": "corepack pnpm exec prisma generate && nest build",
    "start": "nest start",
    "start:prod": "node dist/main.js",
    "typecheck": "corepack pnpm exec prisma generate && tsc --noEmit -p tsconfig.build.json",
    "db:generate": "prisma generate",
    "db:migrate:dev": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:migrate:status": "prisma migrate status",
    "db:studio": "prisma studio"
  },
  "dependencies": {
    "@amaru/shared": "workspace:*",
    "@nestjs/common": "12.5.0",
    "@nestjs/config": "12.1.1",
    "@nestjs/core": "12.5.0",
    "@nestjs/platform-express": "12.5.0",
    "@nestjs/swagger": "12.1.1",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "dotenv": "18.0.10",
    "exceljs": "^4.4.0",
    "joi": "18.3.2",
    "multer": "^2.5.0",
    "pg": "8.23.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@nestjs/cli": "12.0.12",
    "@types/express": "5.0.6",
    "@types/multer": "^2.3.0",
    "@types/node": "24.19.2",
    "prisma": "7.10.1"
  }
}
